{
  "manifest_version": 3,
  "name": "THM Room Tracker",
  "version": "0.1.0",
  "description": "One-click add the current TryHackMe room to the local Room Tracker.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thm-tracker@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Add to Room Tracker",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "notifications", "tabs"],
  "host_permissions": [
    "*://tryhackme.com/*",
    "*://*.tryhackme.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
